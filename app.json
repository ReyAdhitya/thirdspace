{
  "expo": {
    "name": "Thirdspace",
    "slug": "thirdspace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "thirdspace",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E7E4DC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "hk.thirdspace.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Thirdspace uses your photos for an event cover."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#24564A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "hk.thirdspace.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Thirdspace uses your photos for an event cover."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7f31c964-71af-4578-b902-d8ff451baab4"
      }
    },
    "owner": "reyyzhrr"
  }
}
