# Copy into `.env` locally. Never commit `.env`.
# Leave empty to keep the bundled AsyncStorage backend.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Sign-In. One OAuth client id per platform.
# Web client id drives the browser preview on http://localhost:8082.
# Leave empty and the Google button shows a "not configured" banner;
# email login keeps working either way.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Only needed once you build for a real iPhone / Android device.
# Leave empty: Google button on native shows not-configured; email login is the product path.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
