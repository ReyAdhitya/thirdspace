# Copy into `.env` locally. Never commit `.env`.
# Leave empty to keep the bundled AsyncStorage backend.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional. Google Maps Embed API key (Embed is free and unmetered).
# Leave empty to use the keyless Google Maps embed — the map still works.
# Do NOT use a Maps JavaScript / Dynamic Maps key here; those are billed per load.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
